# ===========================================
# GameMaster AI - Environment Variables
# ===========================================
# Bu dosyayı kopyalayıp .env olarak yeniden adlandırın
# ve aşağıdaki değerleri kendi değerlerinizle doldurun.

# -------------------------------------------
# Database (Prisma)
# -------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/gamemaster?schema=public"

# -------------------------------------------
# NextAuth.js
# -------------------------------------------
# Rastgele bir secret key oluşturmak için: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------
# OpenRouter API (AI Models)
# -------------------------------------------
# OpenRouter API key'inizi https://openrouter.ai adresinden alabilirsiniz
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Kullanılacak AI modeli (varsayılan: anthropic/claude-3-sonnet)
OPENROUTER_MODEL="anthropic/claude-3-sonnet"

# Yedek model (opsiyonel)
OPENROUTER_FALLBACK_MODEL="openai/gpt-4-turbo"

# -------------------------------------------
# Application URLs
# -------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# -------------------------------------------
# Node Environment
# -------------------------------------------
NODE_ENV="development"
