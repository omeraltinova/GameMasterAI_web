# ===========================================
# GameMaster AI - Environment Variables
# ===========================================
# Bu dosyayı kopyalayıp .env.local olarak yeniden adlandırın
# ve aşağıdaki değerleri kendi değerlerinizle doldurun.
#
# Prisma CLI .env dosyasını okur, Next.js ise .env.local dosyasını okur.
# Bu yüzden DATABASE_URL hem .env hem .env.local içinde bulunmalıdır.

# -------------------------------------------
# Database (PostgreSQL + Prisma)
# -------------------------------------------
# Development: localhost trust auth (şifresiz)
#   postgresql://postgres@localhost:5432/gamemaster?schema=public
#
# Production: Güçlü şifre + SSL zorunlu
#   postgresql://USER:GUCLU_SIFRE@HOST:5432/gamemaster?schema=public&sslmode=require
#
# IMPORTANT (Production):
#   - pg_hba.conf'ta trust yerine scram-sha-256 kullanın
#   - SSL sertifikası yapılandırın
#   - Connection pooling (PgBouncer / Prisma Accelerate) kullanın
#   - Düzenli backup planı oluşturun
DATABASE_URL="postgresql://postgres@localhost:5432/gamemaster?schema=public"

# -------------------------------------------
# NextAuth.js
# -------------------------------------------
# Development'ta sabit bir key kullanabilirsiniz.
# IMPORTANT (Production):
#   - Güçlü, rastgele bir key oluşturun: openssl rand -base64 32
#   - NEXTAUTH_URL'yi production domain'inize ayarlayın (https:// ile)
NEXTAUTH_SECRET="your-super-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"
# Sadece güvenilir bir reverse-proxy/CDN arkasındaysanız "true" yapın.
# "true" olduğunda rate limit için x-forwarded-for / x-real-ip header'ları kullanılır.
# Doğrudan internete açık bir sunucuda "false" kalmalıdır.
TRUST_PROXY_HEADERS="false"

# -------------------------------------------
# Distributed Rate Limiting (Upstash Redis) — opsiyonel
# -------------------------------------------
# Varsayılan olarak rate limiting işlem içi (in-memory) bir Map ile yapılır; bu
# tek instance (single server / tek container) kurulumlarda doğrudur.
#
# Çoklu instance / serverless (Vercel, çok pod'lu K8s vb.) ortamlarda her
# instance ayrı bir limit havuzuna sahip olur (limitler N kat zayıflar).
# Bu değişkenlerin ikisi de ayarlanırsa rate limiter otomatik olarak Upstash
# Redis'e taşınır ve limitler tüm instance'lar arasında ortaklaşa uygulanır.
# Ayarlanmazsa uygulama herhangi bir bağımlılık olmadan in-memory devam eder.
#
# Upstash REST URL ve token'ı https://upstash.com console'undan alın.
# UPSTASH_REDIS_REST_URL="https://xxx-xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxxx"


# -------------------------------------------
# OpenRouter API (AI Models)
# -------------------------------------------
# OpenRouter API key'inizi https://openrouter.ai adresinden alabilirsiniz
# IMPORTANT (Production):
#   - Production API key kullanın (test key değil)
#   - Rate limiting ayarlayın
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Kullanılacak AI modeli
OPENROUTER_MODEL="anthropic/claude-3-sonnet"

# Yedek model (opsiyonel)
OPENROUTER_FALLBACK_MODEL="openai/gpt-4-turbo"

# Önerilen Aksiyonlar (Suggestions) için ayrı model (opsiyonel)
# Belirtilmezse ana model kullanılır
OPENROUTER_SUGGESTIONS_MODEL="google/gemini-2.0-flash-001"

# -------------------------------------------
# Application URLs
# -------------------------------------------
# IMPORTANT (Production):
#   - HTTPS kullanın
#   - Gerçek domain adresini yazın
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
# Virgülle ayırarak izinli görsel hostlarını belirtin.
# Boş bırakılırsa harici HTTPS görsel URL'leri reddedilir (yalnızca relatif path kabul edilir).
# Örnek: "cdn.example.com,images.example.net"
NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS=""

# -------------------------------------------
# Node Environment
# -------------------------------------------
# IMPORTANT (Production): "production" olarak ayarlayın
NODE_ENV="development"
